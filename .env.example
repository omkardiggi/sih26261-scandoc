# Copy to backend/.env (or run: python -m app.cli init-env, which fills the keys for you).
# Placeholders only — never commit real values.

APP_ENV=development
PUBLIC_BASE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# SQLite (development default) or PostgreSQL, e.g. postgresql+psycopg://user:password@host:5432/ivp
DATABASE_URL=sqlite:///var/app.db
STORAGE_DIR=var/storage

# 32-byte base64 keys — generate with: python -m app.cli generate-keys
STORAGE_ENCRYPTION_KEY=
SECRETS_ENCRYPTION_KEY=
SIGNING_KEY=

# Sessions
SESSION_ABSOLUTE_HOURS=8
SESSION_IDLE_MINUTES=30
# COOKIE_SECURE=true   (defaults to true when APP_ENV=production)

# Background worker inside the API process (set false and run `python -m app.cli worker` separately in production)
RUN_WORKER_IN_PROCESS=true
WORKER_THREADS=2

# Optional: ClamAV daemon for malware scanning
CLAMD_HOST=
CLAMD_PORT=3310
MALWARE_SCAN_REQUIRED=false

# Optional: SMTP for password reset / invitation emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Private mode (recommended): all processing stays on this server; outside AI services are never called.
# OFFICIAL_LOOKUPS only lets the server open the official .gov.in / .nic.in page a document's QR code links to
# (only that address is requested; no document content is sent). Set it to false to block that too.
PRIVATE_MODE=true
ALLOW_OFFICIAL_LOOKUPS=true

# Self-service sign-up from the login page (any email address). To limit it, list domains, e.g. gmail.com,aicte-india.org
SIGNUP_ENABLED=true
SIGNUP_ALLOWED_DOMAINS=

# Optional outside AI analysis (Roboflow workflow; it sends page images to Roboflow and Google Gemini).
# Used only when PRIVATE_MODE=false. With a key set, the workflow below is registered and used automatically:
# every uploaded page is re-read, signatures/stamps/photographs are analysed, and inspection photos are assessed.
# Without a key the platform still works using local OCR and checks only.
# This key is shared ONLY because this repository is private. If the repository is ever made public, rotate it in Roboflow first.
ROBOFLOW_API_KEY=7KQfeGigRP4sjgfjBrwj
ROBOFLOW_WORKSPACE=omkars-workspace-qltv8
DOCUMENT_TEXT_WORKFLOW=document-field-extraction-1792870310871

# Trust anchors for PDF signature validation: files or folders (CCA India roots are bundled in data/trust_roots)
PDF_TRUST_ROOTS=../data/trust_roots

# Video sampling defaults
VIDEO_DEFAULT_SAMPLE_SECONDS=2.0
VIDEO_MAX_FRAMES=600
